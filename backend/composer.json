{
    "name": "yorilife/erp-api",
    "description": "Yorilife ERP REST API (serves the React web app and future mobile apps).",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.3",
        "ext-json": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*"
    },
    "autoload": {
        "psr-4": {
            "App\\Controllers\\": "controllers/",
            "App\\Services\\": "services/",
            "App\\Middleware\\": "middleware/",
            "App\\Database\\": "database/",
            "App\\Repositories\\": "repositories/",
            "App\\Utils\\": "utils/"
        }
    },
    "scripts": {
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "php -S localhost:8000 -t public public/index.php"
        ],
        "migrate": "php bin/migrate.php"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "require-dev": {
        "phpunit/phpunit": "^11"
    }
}
