# Yorilife ERP API — environment configuration
# Copy to .env and fill in real values. Never commit .env.

APP_NAME="Yorilife ERP API"
APP_ENV=local
# Must be false in production. When true, unexpected error messages are returned to the client.
APP_DEBUG=false
# Public URL of the API. Its origin is always allowed to send state-changing requests.
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Kolkata

# Comma-separated list of exact origins allowed to call the API with the session
# cookie (React dev server, production web app). Never use "*".
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---- Sessions (sign-in) ------------------------------------------------------
# Secure cookies are ON by default outside APP_ENV=local; production must be HTTPS.
# When secure, the cookie name gets the "__Host-" prefix automatically.
# SESSION_SECURE_COOKIE=true
# SESSION_COOKIE_NAME=yorilife_session
# SESSION_SAME_SITE=Lax
SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_ABSOLUTE_LIFETIME_HOURS=12
# Defaults to backend/storage/sessions (must not be web-accessible).
# SESSION_SAVE_PATH=

# ---- Failed sign-in throttling ----------------------------------------------
LOGIN_THROTTLE_WINDOW_MINUTES=15
LOGIN_MAX_FAILURES_PER_ACCOUNT=5
LOGIN_MAX_FAILURES_PER_IP=30

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=yorilife_erp
DB_USERNAME=
DB_PASSWORD=
DB_CHARSET=utf8mb4
