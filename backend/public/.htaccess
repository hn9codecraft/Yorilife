# Apache (Laragon/XAMPP/shared hosting): send every request that isn't a real file to index.php
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Pass the Authorization header through to PHP (needed for future token auth)
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [L]
</IfModule>

Options -Indexes
